
-- Create the database
CREATE DATABASE ParkingSystem;

USE ParkingSystem;

[1]
CREATE TABLE Users (
    UserID INT IDENTITY(1,1) PRIMARY KEY,
    FullName NVARCHAR(100) NOT NULL,
    Username NVARCHAR(50) UNIQUE NOT NULL,
    PasswordHash NVARCHAR(255) NOT NULL,
    UserRole NVARCHAR(20) NOT NULL, -- e.g., Admin, Cashier, Staff
    DateCreated DATETIME DEFAULT GETDATE()
);
[2]
CREATE TABLE CurrentUser (
    CurrentUserID INT IDENTITY(1,1) PRIMARY KEY,
    FullName NVARCHAR(100) NOT NULL,
    Username NVARCHAR(50) UNIQUE NOT NULL,
    [Role] NVARCHAR(20) NOT NULL, -- e.g., Admin, Cashier, Staff
    TimeLoggedin DATETIME DEFAULT GETDATE()
);
[3]
-- Client Table
CREATE TABLE Client (
    ClientID NVARCHAR(10) PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL,
    Address NVARCHAR(255),
    CpNumber NVARCHAR(20),
    IDPicture NVARCHAR(MAX),
	Discount NVARCHAR(50)
);
[4]
-- Vehicle Table
CREATE TABLE Vehicle (
    VehicleID NVARCHAR(10) PRIMARY KEY,
    Brand NVARCHAR(50),
    Color NVARCHAR(50),
    PlateNumber NVARCHAR(20) NOT NULL,
    ClientID NVARCHAR(10) NOT NULL,
    VehicleType NVARCHAR(50),
    FOREIGN KEY (ClientID) REFERENCES Client(ClientID) ON DELETE CASCADE
);

[5]
-- Parkingslot Table
CREATE TABLE Parkingslot (
    SlotID INT IDENTITY(1,1) PRIMARY KEY,
    VehicleID NVARCHAR(10) NULL,
    ClientID NVARCHAR(10) NULL,
    VehicleStatus VARCHAR(50),
    SlotStatus VARCHAR(50) NOT NULL,
    SlotNumber VARCHAR(50) NOT NULL,
    FOREIGN KEY (VehicleID) REFERENCES Vehicle(VehicleID),
    FOREIGN KEY (ClientID) REFERENCES Client(ClientID),
);

