-- VehicleSessions Table (now includes 'Daily' in the CHECK constraint)
CREATE TABLE VehicleSessions (
    SessionID INT PRIMARY KEY IDENTITY(1,1) NOT NULL,
    VehicleID VARCHAR(50) NOT NULL,
    DurationType NVARCHAR(50) NOT NULL CHECK (DurationType IN ('Daily', 'Weekly', 'Monthly', 'Yearly')),
    StartDate DATE NOT NULL,
    EndDateTime DATETIME NOT NULL,
    TotalAmount DECIMAL(10, 2) NOT NULL
);

-- Parkingslot Table
CREATE TABLE Parkingslot (
    SlotID INT IDENTITY(1,1) PRIMARY KEY,
    VehicleID NVARCHAR(10) NULL,
    ClientID NVARCHAR(10) NULL,
	SessionID int NULL,
    VehicleStatus VARCHAR(50),
    SlotStatus VARCHAR(50) NOT NULL,
    SlotNumber VARCHAR(50) NOT NULL,
    FOREIGN KEY (VehicleID) REFERENCES Vehicle(VehicleID),
    FOREIGN KEY (ClientID) REFERENCES Client(ClientID),
	FOREIGN KEY (SessionID) REFERENCES RegularParkingSessions(SessionID),
	AvailableSlotM INT NOT NULL,
	AvailableSlotV INT NOT NULL,
	OccupiedSlotM INT NOT NULL,
	OccupiedSlotV INT NOT NULL
);

