[6]
-- VehicleSessions Table (now includes 'Daily' in the CHECK constraint)
CREATE TABLE VehicleSessions (
    SessionID INT PRIMARY KEY IDENTITY(1,1) NOT NULL,
	SlotID INT UNIQUE,
    VehicleID NVARCHAR(10) NULL,
    DurationType NVARCHAR(50) NOT NULL CHECK (DurationType IN ('Daily', 'Weekly', 'Monthly', 'Yearly')),
    StartDate DATE NOT NULL,
    EndDateTime DATETIME NOT NULL,
    TotalAmount DECIMAL(10, 2) NOT NULL
	FOREIGN KEY (VehicleID) REFERENCES Vehicle(VehicleID),
	FOREIGN KEY (SlotID) REFERENCES Parkingslot(SlotID),
);
[7]
CREATE TABLE TransactionsRent (
	TransactionID INT IDENTITY(1,1) PRIMARY KEY,
    TransactionDate DATE NOT NULL DEFAULT GETDATE(),
	CashInHand DECIMAL NOT NULL,
	[Change] DECIMAL NOT NULL,
	SessionID INT,
	FOREIGN KEY (SessionID) REFERENCES VehicleSessions(SessionID)
);

[8]
-- RegularParkingSessions Table (create this BEFORE Fee!)
CREATE TABLE RegularParkingSessions (
    SessionID INT IDENTITY(1,1) PRIMARY KEY,
    RegularVehicleID NVARCHAR(10)NOT NULL,
    VehicleType NVARCHAR(50)NOT NULL,
    TimeIn DATETIME NOT NULL,
    [TimeOut] DATETIME NULL,
    TotalAmount DECIMAL(10,2) NULL,
	Discount NVARCHAR (50) NOT NULL
);

[9]
CREATE TABLE RegularSlot (
	RegSlotID INT IDENTITY(1,1) PRIMARY KEY,
	SessionID int NULL,
	AvailableSlotM INT NOT NULL,
	AvailableSlotV INT NOT NULL,
	OccupiedSlotM INT DEFAULT 0,
	OccupiedSlotV INT DEFAULT 0,
	FOREIGN KEY (SessionID) REFERENCES RegularParkingSessions(SessionID),
);


INSERT INTO RegularSlot (AvailableSlotM, AvailableSlotV)
VALUES
(95, 55);
[10]
CREATE TABLE RegularParkingTotals (
    TotalID INT IDENTITY(1,1) PRIMARY KEY,
	RegSlotID INT NULL,
    SessionID int,
    VehicleType NVARCHAR(50) NOT NULL,
    TimeIn DATETIME NOT NULL,
    [TimeOut] DATETIME NULL,
	QRCodeImage NVARCHAR(MAX) NOT NULL,
	Totalamount DECIMAL(10,2) NULL,
	Discount NVARCHAR (50) NOT NULL,
    FOREIGN KEY (SessionID) REFERENCES RegularParkingSessions(SessionID),
	FOREIGN KEY (RegSlotID) REFERENCES RegularSlot(RegSlotID),
);
[11]
CREATE TABLE TransactionsReg (
	TransactionID INT IDENTITY(1,1) PRIMARY KEY,
    TransactionDate DATE NOT NULL DEFAULT GETDATE(),
	CashInHand DECIMAL NOT NULL,
	[Change] DECIMAL NOT NULL,
	TotalID INT,
	FOREIGN KEY (TotalID) REFERENCES RegularParkingTotals(TotalID)
);

[12]
-- Fee Table
CREATE TABLE Fee (
    FeeID INT PRIMARY KEY IDENTITY(1,1),
    ClientID NVARCHAR(10) NULL,
    SessionID INT NULL,
    VehicleType NVARCHAR(50),
    DurationType NVARCHAR(50),
    FixedPrice DECIMAL(10,2) NOT NULL,
    FOREIGN KEY (SessionID) REFERENCES RegularParkingSessions(SessionID),
    FOREIGN KEY (ClientID) REFERENCES Client(ClientID)
);


