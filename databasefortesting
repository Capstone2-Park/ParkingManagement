[13]
CREATE TABLE DailyReport (
    DailyReportID INT IDENTITY(1,1) PRIMARY KEY,
    ReportDateFrom DATE NOT NULL DEFAULT GETDATE(),
	ReportDateTo DATE NOT NULL DEFAULT GETDATE(),
	PeakHoursJson NVARCHAR (MAX),
);


CREATE TABLE DailyFinanceSum (
    DailyFinanceID INT IDENTITY(1,1) PRIMARY KEY,
    ReportDateSum DATE NOT NULL,
    TotalTransaction INT NOT NUll,              -- number of vehicles for the day
    TotalRentTransaction INT NOT NUll,  -- total daily revenue
    TotalRegTransaction INT NOT NUll,
	TotalRentRevenue DECIMAL(12,2) DEFAULT 0,
	TotalRegRevenue DECIMAL(12,2) DEFAULT 0,
	TotalRevenue DECIMAL(12,2) DEFAULT 0,
);


CREATE TABLE WeeklyFinanceSum (
    WeeklyFinanceID INT IDENTITY(1,1) PRIMARY KEY,
    WeekStart DATE NOT NULL,
	WeekEnd DATE NOT NULL,
    TotalTransaction INT NOT NUll,              -- number of vehicles for the day
    TotalRentTransaction INT NOT NUll,  -- total daily revenue
    TotalRegTransaction INT NOT NUll,
	TotalRentRevenue DECIMAL(12,2) DEFAULT 0,
	TotalRegRevenue DECIMAL(12,2) DEFAULT 0,
	TotalRevenue DECIMAL(12,2) DEFAULT 0,
);


CREATE TABLE MonthlyFinanceSum (
    MonthlyFinanceID INT IDENTITY(1,1) PRIMARY KEY,
    MonthStart DATE NOT NULL,
	MonthEnd DATE NOT NULL,
    TotalTransaction INT NOT NUll,              -- number of vehicles for the day
    TotalRentTransaction INT NOT NUll,  -- total daily revenue
    TotalRegTransaction INT NOT NUll,
	TotalRentRevenue DECIMAL(12,2) DEFAULT 0,
	TotalRegRevenue DECIMAL(12,2) DEFAULT 0,
	TotalRevenue DECIMAL(12,2) DEFAULT 0,
);

CREATE TABLE SlotHistory (
	SlotHistoryID INT IDENTITY(1,1) PRIMARY KEY,
    [Date] DATE NOT NULL DEFAULT GETDATE(),
	AvailableSlotM INT NOT NULL,
	AvailableSlotV INT NOT NULL,
	AvailableParkingSlots INT NOT NULL,
);
