-- Create  database
CREATE DATABASE ParkingSystemNormalized;
USE ParkingSystemNormalized;

-- 1. Client Table
CREATE TABLE Client (
    ClientID NVARCHAR(10) PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL,
    Address NVARCHAR(255),
    CpNumber NVARCHAR(20),
    IDPicture NVARCHAR(MAX)
);

-- 2. Vehicle Table
CREATE TABLE Vehicle (
    VehicleID NVARCHAR(10) PRIMARY KEY,
    ClientID NVARCHAR(10) NOT NULL,
    Brand NVARCHAR(50),
    Color NVARCHAR(50),
    PlateNumber NVARCHAR(20) NOT NULL UNIQUE,
    VehicleType NVARCHAR(50) NOT NULL CHECK (VehicleType IN ('2-Wheels', '4-Wheels')),
    FOREIGN KEY (ClientID) REFERENCES Client(ClientID) ON DELETE CASCADE
);

-- 3. Parking Slot Table 
CREATE TABLE ParkingSlot (
    SlotID INT IDENTITY(1,1) PRIMARY KEY,
    SlotNumber VARCHAR(50) NOT NULL UNIQUE,
    SlotStatus VARCHAR(50) NOT NULL CHECK (SlotStatus IN ('available', 'occupied')),
    VehicleStatus VARCHAR(50) NOT NULL CHECK (VehicleStatus IN ('Parked', 'NotParked'))
);

-- 4. Parking Availability Table (Stores global counts)
CREATE TABLE ParkingAvailability (
    AvailabilityID INT IDENTITY(1,1) PRIMARY KEY,
    AvailableSlotM INT NOT NULL,
    AvailableSlotV INT NOT NULL,
    LastUpdated DATETIME DEFAULT GETDATE()
);

-- 5. Parking Sessions Table (One table for all session data)
CREATE TABLE ParkingSession (
    SessionID INT IDENTITY(1,1) PRIMARY KEY,
    VehicleID NVARCHAR(10) NOT NULL,
    SlotID INT NOT NULL,
    TimeIn DATETIME NOT NULL,
    TimeOut DATETIME NULL,
    DurationType NVARCHAR(50) CHECK (DurationType IN ('Daily', 'Weekly', 'Monthly', 'Yearly')),
    TotalAmount DECIMAL(10, 2) NULL,
    QRCodeImage NVARCHAR(MAX) NULL,
    FOREIGN KEY (VehicleID) REFERENCES Vehicle(VehicleID),
    FOREIGN KEY (SlotID) REFERENCES ParkingSlot(SlotID)
);

-- 6. Fee Table (No ClientID; linked by VehicleType + DurationType)
CREATE TABLE Fee (
    FeeID INT IDENTITY(1,1) PRIMARY KEY,
    VehicleType NVARCHAR(50) NOT NULL CHECK (VehicleType IN ('2-Wheels', '4-Wheels')),
    DurationType NVARCHAR(50) NOT NULL CHECK (DurationType IN ('Daily', 'Weekly', 'Monthly', 'Yearly')),
    FixedPrice DECIMAL(10,2) NOT NULL
);

